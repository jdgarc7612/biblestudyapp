// Lets anyone try the app in the browser without installing anything:
// on GitHub, Code > Codespaces > Create codespace on this branch. The app opens in a new tab.
{
  "name": "DeepWord preview",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "npm ci",
  // CI=1 keeps Expo from stopping to ask questions; the web app is served on port 8081.
  "postAttachCommand": "CI=1 npx expo start --web --port 8081",
  "forwardPorts": [8081],
  "portsAttributes": {
    "8081": { "label": "DeepWord app", "onAutoForward": "openBrowser" }
  }
}
